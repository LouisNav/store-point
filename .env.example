# ============================================================
# Store Point — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- App ---
# Public origin (used in receipt links, emails later).
APP_URL=http://localhost:3000

# --- Auth ---
# 32+ chars random string used to encrypt session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=please_replace_with_a_long_random_string_at_least_32_chars

# --- Root Admin bootstrap (env-seeded, used by `npm run seed`) ---
ROOT_ADMIN_EMAIL=root@example.com
ROOT_ADMIN_PASSWORD=ChangeMe!Strong#Pass1
ROOT_ADMIN_NAME=Root

# --- MongoDB (primary cloud store) ---
# If unset or unreachable, the app runs in OFFLINE mode and queues writes for later flush.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/storepoint
MONGODB_URI=
MONGODB_DB=storepoint

# --- Local SQLite path (relative to project root) ---
SQLITE_PATH=./data/storepoint.db

# --- Sync worker tuning ---
SYNC_INTERVAL_MS=5000
SYNC_BATCH_SIZE=200
SYNC_BACKOFF_MAX_MS=60000

# --- Server Actions ---
# Comma-separated origins allowed to invoke Server Actions.
# Add your Codespace / proxy / custom domain origins here.
# Example: *.app.github.dev,localhost:3000,my-domain.com
ALLOWED_ORIGINS=localhost:3000
