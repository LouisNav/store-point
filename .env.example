APP_URL=http://localhost:3000
PORT=3000
ALLOWED_ORIGINS=localhost:3000

# Required: use a long random value in production.
SESSION_PASSWORD=replace-with-at-least-32-random-characters
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=replace-with-a-strong-password
ROOT_ADMIN_NAME=Root Admin

# Optional MongoDB sync. Leave empty for offline/local-only mode.
MONGODB_URI=
MONGODB_DB=storepoint

# Local default; Docker Compose overrides this to /app/data/storepoint.db.
SQLITE_PATH=./data/storepoint.db
SYNC_INTERVAL_MS=5000
SYNC_BATCH_SIZE=200
SYNC_BACKOFF_MAX_MS=60000
